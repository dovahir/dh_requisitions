<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dh_requisitions.RequisitionDashboard">
        <div class="o_requisitions_dashboard p-3 p-md-4">
            <!-- Hero Header Ergonómico -->
            <div class="o_req_hero mb-4 p-4 rounded-3 shadow-sm border">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge rounded-pill text-bg-primary px-3 py-1 fw-semibold">
                                <i class="fa fa-clipboard-list me-1"/>
                                <t t-esc="state.data.role_label || 'Requisiciones'"/>
                            </span>
                            <span class="text-muted small">
                                <i class="fa fa-calendar me-1"/>
                                <t t-esc="state.data.today"/>
                            </span>
                        </div>
                        <h2 class="o_req_title mb-0 fw-bold">
                            Hola, <t t-esc="state.data.user_name"/>
                        </h2>
                    </div>

                    <!-- Botonera de Acción Principal y Accesos de Vista -->
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <button t-if="state.data.primary_action"
                                class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2 fw-semibold shadow-sm"
                                t-on-click="triggerPrimaryAction">
                            <i t-attf-class="fa #{state.data.primary_action.icon}"/>
                            <span t-esc="state.data.primary_action.label"/>
                        </button>

                        <button t-if="state.data.can_create and state.data.primary_action?.action !== 'create_new'"
                                class="btn btn-outline-primary d-flex align-items-center gap-1 px-3 py-2 fw-semibold"
                                t-on-click="createNewRequisition">
                            <i class="fa fa-plus"/>
                            <span>Nueva Requisición</span>
                        </button>

                        <div class="btn-group shadow-sm ms-md-2" role="group" aria-label="Cambiar vista">
                            <button type="button" class="btn btn-outline-secondary" title="Vista Lista"
                                    t-on-click="() => this.openView('list')">
                                <i class="fa fa-list"/>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" title="Vista Kanban"
                                    t-on-click="() => this.openView('kanban')">
                                <i class="fa fa-th-large"/>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" title="Análisis Gráfico"
                                    t-on-click="() => this.openView('graph')">
                                <i class="fa fa-bar-chart"/>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" title="Matriz Pivote"
                                    t-on-click="() => this.openView('pivot')">
                                <i class="fa fa-table"/>
                            </button>
                        </div>

                        <button class="btn btn-outline-secondary shadow-sm" title="Actualizar datos"
                                t-att-disabled="state.loading"
                                t-on-click="refresh">
                            <i t-attf-class="fa fa-refresh #{state.loading ? 'fa-spin' : ''}"/>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Contenedor de Tarjetas KPI -->
            <div t-if="state.loaded">
                <div class="row g-3">
                    <div t-foreach="state.data.cards" t-as="card" t-key="card.key"
                         class="col-12 col-sm-6 col-lg-4 col-xl-4">
                        <div t-attf-class="card h-100 shadow-sm o_kpi_card o_kpi_card_#{card.color}"
                             t-on-click="() => this.openCard(card)"
                             role="button"
                             tabindex="0">
                            <div class="card-body p-3 p-md-4 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center me-2">
                                    <div class="o_kpi_icon_wrapper rounded-3 d-flex align-items-center justify-content-center me-3">
                                        <i t-attf-class="fa #{card.icon} fa-2x"/>
                                    </div>
                                    <div>
                                        <div class="o_kpi_value fw-bold" t-esc="card.value"/>
                                        <div class="o_kpi_title fw-semibold" t-esc="card.title"/>
                                        <div t-if="card.badge" class="mt-1">
                                            <span t-attf-class="badge rounded-pill o_kpi_badge_#{card.color} small" t-esc="card.badge"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kpi_arrow">
                                    <i class="fa fa-chevron-right"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mensaje cuando no hay tarjetas -->
                <div t-if="state.data.cards.length === 0" class="card border shadow-sm p-4 text-center mt-3 o_req_empty_state">
                    <p class="text-muted mb-0">No hay métricas disponibles en este momento.</p>
                </div>
            </div>

            <!-- Estado de Carga -->
            <div t-if="!state.loaded" class="card border shadow-sm p-5 text-center mt-3 o_req_loading_state">
                <i class="fa fa-spinner fa-spin fa-2x text-primary mb-2"/>
                <p class="text-muted mb-0">Cargando tablero de requisiciones...</p>
            </div>
        </div>
    </t>
</templates>
