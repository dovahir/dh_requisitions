<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_requisition_supply_request_add_pending_wizard_form" model="ir.ui.view">
        <field name="name">requisition.supply.request.add.pending.wizard.form</field>
        <field name="model">requisition.supply.request.add.pending.wizard</field>
        <field name="arch" type="xml">
            <form string="Agregar desde Pendientes de Envío">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Seleccione las partidas pendientes con destino a la obra <strong><field name="warehouse_dest_id" readonly="1" options="{'no_open': True}"/></strong> que desea incorporar a esta Solicitud de Suministro.
                    </div>
                    <field name="supply_request_id" invisible="1"/>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="supply_line_id" column_invisible="1"/>
                            <field name="selected" widget="boolean_toggle"/>
                            <field name="product_id"/>
                            <field name="product_uom_id"/>
                            <field name="product_qty"/>
                            <field name="requester_name"/>
                            <field name="requisition_id"/>
                            <field name="notes"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Incorporar a Solicitud" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_requisition_supply_request_add_pending_wizard" model="ir.actions.act_window">
        <field name="name">Agregar desde Pendientes de Envío</field>
        <field name="res_model">requisition.supply.request.add.pending.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
