<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_requisition_supply_request_cancel_wizard_form" model="ir.ui.view">
        <field name="name">requisition.supply.request.cancel.wizard.form</field>
        <field name="model">requisition.supply.request.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancelar Solicitud de Suministro">
                <p class="text-danger mb-3">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    Esta acción cancelará la Solicitud de Suministro y registrará el motivo detallado en la bitácora de auditoría (Chatter).
                </p>
                <group>
                    <field name="request_id" readonly="1" force_save="1"/>
                    <field name="cancel_stock_moves"/>
                    <field name="cancellation_reason" placeholder="Explique las razones de la cancelación..."/>
                </group>
                <footer>
                    <button name="action_confirm_cancel"
                            string="Confirmar Cancelación"
                            type="object"
                            class="btn-danger"/>
                    <button string="Descartar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_requisition_supply_request_cancel_wizard" model="ir.actions.act_window">
        <field name="name">Cancelar Solicitud de Suministro</field>
        <field name="res_model">requisition.supply.request.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
