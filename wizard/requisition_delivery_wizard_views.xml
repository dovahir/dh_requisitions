<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Vista Formulario del Asistente de Despacho y Entrega -->
    <record id="view_requisition_delivery_wizard_form" model="ir.ui.view">
        <field name="name">requisition.delivery.wizard.form</field>
        <field name="model">requisition.delivery.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Despacho y Entrega">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Seleccione las cantidades que desea surtir en este despacho. Las líneas con cantidad cero serán ignoradas y permanecerán pendientes en la requisición.
                    </div>
                    <group>
                        <group string="Datos de Origen y Destino">
                            <field name="requisition_id"/>
                            <field name="warehouse_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Configuración de Ubicaciones">
                            <field name="picking_type_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="location_id" options="{'no_create': True}"/>
                            <field name="location_dest_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Partidas a Despachar" name="lines_page">
                            <field name="line_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="requisition_line_id" column_invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="product_uom_id"/>
                                    <field name="qty_requested"/>
                                    <field name="qty_pending"/>
                                    <field name="qty_to_deliver"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Generar Entrega" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana para el Wizard -->
    <record id="action_requisition_delivery_wizard" model="ir.actions.act_window">
        <field name="name">Generar Despacho / Entrega</field>
        <field name="res_model">requisition.delivery.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
