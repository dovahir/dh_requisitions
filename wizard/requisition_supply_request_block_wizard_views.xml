<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_requisition_supply_request_block_wizard_form" model="ir.ui.view">
        <field name="name">requisition.supply.request.block.wizard.form</field>
        <field name="model">requisition.supply.request.block.wizard</field>
        <field name="arch" type="xml">
            <form string="Hacer Corte de Almacén">
                <p class="text-muted">
                    Al realizar el corte, esta solicitud de suministro quedará <strong>bloqueada</strong> para impedir que se agreguen más partidas desde requisiciones de obra mientras se alista el envío.
                </p>
                <group>
                    <field name="request_id" readonly="1" force_save="1"/>
                    <field name="create_new"/>
                    <field name="scheduled_date" invisible="not create_new"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Confirmar Corte"
                            type="object"
                            class="btn-primary"/>
                    <button string="Descartar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_requisition_supply_request_block_wizard" model="ir.actions.act_window">
        <field name="name">Hacer Corte de Almacén</field>
        <field name="res_model">requisition.supply.request.block.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
