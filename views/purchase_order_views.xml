<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="purchase_order_form_inherit_dh_requisitions" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.dh_requisitions</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Smart Button en button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_purchase_request_lines"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="purchase_request_line_count == 0">
                    <field name="purchase_request_line_count" widget="statinfo" string="Solicitudes"/>
                </button>
            </xpath>

            <!-- Campo oculto para trazabilidad de solicitudes de compra -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="purchase_request_line_ids" invisible="1"/>
            </xpath>

            <!-- Botón en lista de partidas para ver la solicitud origen -->
            <xpath expr="//field[@name='order_line']//list//field[@name='price_subtotal']" position="after">
                <field name="purchase_request_lines" column_invisible="1"/>
                <button name="action_open_request_line"
                        type="object"
                        icon="fa-list"
                        title="Ver Solicitud de Compra Origen"
                        invisible="not purchase_request_lines"
                        optional="hide"/>
            </xpath>

            <!-- Notas de requisición en la cabecera -->
            <xpath expr="//page[@name='products']/group/group/field[@name='note']" position="before">
                <field colspan="2" name="req_note" placeholder="Notas transferidas desde la requisición..." invisible="not req_note" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
