<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================= -->
        <!-- PRIVILEGIOS Y GRUPOS DE SEGURIDAD (ODOO 19)                    -->
        <!-- ============================================================= -->

        <!-- 1. Privilegio Requisiciones -->
        <record id="res_groups_privilege_requisitions" model="res.groups.privilege">
            <field name="name">Requisiciones</field>
            <field name="category_id" ref="base.module_category_supply_chain"/>
            <field name="sequence">10</field>
        </record>

        <!-- 2. Privilegio Solicitudes de Suministro -->
        <record id="res_groups_privilege_stock_request" model="res.groups.privilege">
            <field name="name">Solicitudes de Suministro</field>
            <field name="category_id" ref="base.module_category_supply_chain"/>
            <field name="sequence">20</field>
        </record>

        <!-- ============================================================= -->
        <!-- GRUPOS: REQUISICIONES                                         -->
        <!-- ============================================================= -->
        <!-- 1.1 Grupo: Solicitante -->
        <record id="group_requisitions_requester" model="res.groups">
            <field name="name">Solicitante</field>
            <field name="privilege_id" ref="res_groups_privilege_requisitions"/>
            <field name="sequence">10</field>
            <field name="comment">Permite visualizar y crear requisiciones de su departamento.</field>
        </record>

        <!-- 1.2 Grupo: Líder / Aprobador -->
        <record id="group_requisitions_approver" model="res.groups">
            <field name="name">Líder / Aprobador</field>
            <field name="privilege_id" ref="res_groups_privilege_requisitions"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_requisitions_requester'))]"/>
            <field name="comment">Permite autorizar o rechazar requisiciones de la compañía y ajustar cantidades en revisión.</field>
        </record>

        <!-- 1.3 Grupo: Administrador -->
        <record id="group_requisitions_manager" model="res.groups">
            <field name="name">Administrador</field>
            <field name="privilege_id" ref="res_groups_privilege_requisitions"/>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(6, 0, [ref('group_requisitions_approver')])]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Acceso omnímodo a la gestión de requisiciones y configuración.</field>
        </record>

        <!-- ============================================================= -->
        <!-- GRUPOS: SOLICITUDES DE SUMINISTRO                             -->
        <!-- ============================================================= -->
        <!-- 2.1 Grupo: Usuarios (Consulta) -->
        <record id="group_stock_request_only_read" model="res.groups">
            <field name="name">Usuarios (Consulta)</field>
            <field name="privilege_id" ref="res_groups_privilege_stock_request"/>
            <field name="sequence">10</field>
            <field name="comment">Permite consultar el seguimiento de solicitudes de suministro y traslados.</field>
        </record>

        <!-- 2.2 Grupo: Empleado almacén obra -->
        <record id="group_stock_request_planta" model="res.groups">
            <field name="name">Empleado almacén obra</field>
            <field name="privilege_id" ref="res_groups_privilege_stock_request"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_stock_request_only_read')), (4, ref('stock.group_stock_user'))]"/>
            <field name="comment">Permite gestionar entregas locales al solicitante, pedir suministros y agregar líneas manuales a solicitudes existentes.</field>
        </record>

        <!-- 2.3 Grupo: Empleado almacén base -->
        <record id="group_stock_request_employee" model="res.groups">
            <field name="name">Empleado almacén base</field>
            <field name="privilege_id" ref="res_groups_privilege_stock_request"/>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('group_stock_request_planta'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Permite realizar cortes de embarque, generar salidas a tránsito y gestionar el pool de pendientes.</field>
        </record>

        <!-- ============================================================= -->
        <!-- REGLAS DE REGISTRO (MULTI-COMPAÑÍA - GLOBALES)               -->
        <!-- ============================================================= -->
        <record id="requisitions_comp_rule" model="ir.rule">
            <field name="name">Requisiciones Multi-Compañía</field>
            <field name="model_id" ref="model_requisitions"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="requisitions_line_comp_rule" model="ir.rule">
            <field name="name">Línea de Requisición Multi-Compañía</field>
            <field name="model_id" ref="model_requisitions_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="requisition_supply_request_comp_rule" model="ir.rule">
            <field name="name">Solicitud de Suministro Multi-Compañía</field>
            <field name="model_id" ref="model_requisition_supply_request"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="requisition_supply_request_line_comp_rule" model="ir.rule">
            <field name="name">Línea de Solicitud de Suministro Multi-Compañía</field>
            <field name="model_id" ref="model_requisition_supply_request_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="requisition_purchase_request_line_comp_rule" model="ir.rule">
            <field name="name">Línea de Solicitud de Compra Multi-Compañía</field>
            <field name="model_id" ref="model_requisition_purchase_request_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="requisition_allocation_comp_rule" model="ir.rule">
            <field name="name">Asignación de Requisición Multi-Compañía</field>
            <field name="model_id" ref="model_requisition_allocation"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- ============================================================= -->
        <!-- REGLAS DE REGISTRO POR GRUPO (DEPARTAMENTO Y ESTADO)         -->
        <!-- ============================================================= -->

        <!-- 1. Reglas para Requisiciones de Cabecera -->
        <!-- 1.1 Lectura: creador, solicitante o departamento en cualquier estado -->
        <record id="requisitions_requester_department_read_rule" model="ir.rule">
            <field name="name">Requisiciones: Solicitante/Empleado/Departamento Consulta</field>
            <field name="model_id" ref="model_requisitions"/>
            <field name="groups" eval="[(4, ref('dh_requisitions.group_requisitions_requester'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="domain_force">['|', '|', ('create_uid', '=', user.id), ('employee_id.user_id', '=', user.id), '&amp;', ('department_id', '!=', False), ('department_id', '=', user.employee_id.department_id.id)]</field>
        </record>

        <!-- 1.2 Escritura y Eliminación: en estado borrador o rechazada -->
        <record id="requisitions_requester_department_write_rule" model="ir.rule">
            <field name="name">Requisiciones: Solicitante/Empleado/Departamento Borrador/Rechazada Edición</field>
            <field name="model_id" ref="model_requisitions"/>
            <field name="groups" eval="[(4, ref('dh_requisitions.group_requisitions_requester'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="domain_force">['&amp;', ('state', 'in', ('draft', 'rejected')), '|', '|', ('create_uid', '=', user.id), ('employee_id.user_id', '=', user.id), '&amp;', ('department_id', '!=', False), ('department_id', '=', user.employee_id.department_id.id)]</field>
        </record>

        <record id="requisitions_approver_manager_rule" model="ir.rule">
            <field name="name">Requisiciones: Aprobador/Administrador (Compañía Completa)</field>
            <field name="model_id" ref="model_requisitions"/>
            <field name="groups" eval="[(4, ref('dh_requisitions.group_requisitions_approver')), (4, ref('dh_requisitions.group_requisitions_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="requisitions_stock_user_read_rule" model="ir.rule">
            <field name="name">Requisiciones: Personal de Inventario Consulta</field>
            <field name="model_id" ref="model_requisitions"/>
            <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="requisitions_purchase_user_read_rule" model="ir.rule">
            <field name="name">Requisiciones: Compras Consulta</field>
            <field name="model_id" ref="model_requisitions"/>
            <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- 2. Reglas para Líneas de Requisición -->
        <!-- 2.1 Lectura: líneas de requisiciones visibles para el usuario -->
        <record id="requisitions_line_requester_read_rule" model="ir.rule">
            <field name="name">Línea Requisición: Solicitante/Empleado/Departamento Consulta</field>
            <field name="model_id" ref="model_requisitions_line"/>
            <field name="groups" eval="[(4, ref('dh_requisitions.group_requisitions_requester'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="domain_force">['|', '|', ('requisition_id.create_uid', '=', user.id), ('requisition_id.employee_id.user_id', '=', user.id), '&amp;', ('requisition_id.department_id', '!=', False), ('requisition_id.department_id', '=', user.employee_id.department_id.id)]</field>
        </record>

        <!-- 2.2 Escritura y Eliminación: solo cuando la requisición está en borrador -->
        <record id="requisitions_line_requester_write_rule" model="ir.rule">
            <field name="name">Línea Requisición: Solicitante/Empleado/Departamento Borrador Edición</field>
            <field name="model_id" ref="model_requisitions_line"/>
            <field name="groups" eval="[(4, ref('dh_requisitions.group_requisitions_requester'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="domain_force">['&amp;', ('requisition_id.state', '=', 'draft'), '|', '|', ('requisition_id.create_uid', '=', user.id), ('requisition_id.employee_id.user_id', '=', user.id), '&amp;', ('requisition_id.department_id', '!=', False), ('requisition_id.department_id', '=', user.employee_id.department_id.id)]</field>
        </record>

        <record id="requisitions_line_approver_manager_rule" model="ir.rule">
            <field name="name">Línea Requisición: Aprobador/Administrador (Compañía Completa)</field>
            <field name="model_id" ref="model_requisitions_line"/>
            <field name="groups" eval="[(4, ref('dh_requisitions.group_requisitions_approver')), (4, ref('dh_requisitions.group_requisitions_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="requisitions_line_stock_user_read_rule" model="ir.rule">
            <field name="name">Línea Requisición: Personal de Inventario Consulta</field>
            <field name="model_id" ref="model_requisitions_line"/>
            <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="requisitions_line_purchase_user_read_rule" model="ir.rule">
            <field name="name">Línea Requisición: Compras Consulta</field>
            <field name="model_id" ref="model_requisitions_line"/>
            <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
